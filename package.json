{
  "name": "housecalc",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @housecalc/web",
    "build": "npm run build -w @housecalc/web",
    "test": "node --test 'packages/*/test/**/*.test.ts' 'scripts/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rates": "node scripts/rates/update.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "cheerio": "^1.2.0",
    "typescript": "^5.9.0"
  }
}
