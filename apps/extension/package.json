{
  "name": "@housecalc/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "e2e": "HOUSECALC_E2E=1 wxt build && node --test 'e2e/*.e2e.ts'"
  },
  "dependencies": {
    "@housecalc/core": "*",
    "@housecalc/listing": "*"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wxt": "^0.21.4"
  }
}
